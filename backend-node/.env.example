# Postgres connection string (required — app fails fast if unset)
DATABASE_URL="postgresql://vani:vani@localhost:5439/vani_db?schema=public"

# JWT signing secret (required — app fails fast if unset; no insecure fallback)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRY_HOURS="24"

# Groq LLM API key (optional — parser degrades to rule-based if absent)
GROQ_API_KEY=""

# Comma-separated extra CORS origins (localhost dev origins are always allowed)
ALLOWED_ORIGINS=""

# Server port
PORT="8001"
